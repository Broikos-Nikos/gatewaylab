{
  "name": "gatewaylab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && npm run check && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check": "npm run check:source && npm run check:drill && npm run check:harness && npm run check:spread",
    "check:source": "node tools/check-source.mjs",
    "check:drill": "node tools/check-drill.mjs",
    "check:harness": "node tools/check-harness.mjs",
    "check:spread": "node tools/check-spread.mjs",
    "run:drill": "node tools/run-drill.mjs",
    "check:page": "node tools/check-page.mjs",
    "verify": "node tools/verify.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "playwright": "^1.61.1",
    "tsx": "4.20.6",
    "typescript": "^5.9.3",
    "vite": "^8.3.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "fsevents": true
  }
}
